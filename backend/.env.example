# Copy this file to .env and replace the placeholders on your own machine.
# Never commit .env or put real credentials in source control.
INVENTORY_MYSQL_HOST=127.0.0.1
INVENTORY_MYSQL_PORT=3306
INVENTORY_MYSQL_DATABASE=inventory_management
INVENTORY_MYSQL_USER=inventory_app
INVENTORY_MYSQL_PASSWORD=
INVENTORY_POOL_SIZE=5
INVENTORY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
INVENTORY_AUTH_SESSION_HOURS=12
INVENTORY_AUTH_COOKIE_SECURE=false
INVENTORY_AUTH_COOKIE_SAMESITE=lax
INVENTORY_FRONTEND_URL=http://127.0.0.1:5173
INVENTORY_SMTP_HOST=
INVENTORY_SMTP_PORT=587
# Set these privately in backend/.env or the production host's environment settings.
INVENTORY_SMTP_USERNAME=
INVENTORY_SMTP_PASSWORD=
INVENTORY_SMTP_FROM_EMAIL=
INVENTORY_SMTP_FROM_NAME=Inventory Desk
INVENTORY_SMTP_STARTTLS=true
INVENTORY_SMTP_USE_SSL=false
